PORT=4000
TARGET_PROFIT_MARGIN=0.15

# Frontend / custom-domain cutover
FRONTEND_BASE_URL=https://custom-ecommerce-seven.vercel.app
API_BASE_URL=https://custom-ecommerce-qp30.onrender.com
CORS_ALLOWED_ORIGINS=https://custom-ecommerce-seven.vercel.app,http://localhost:5173

# SQLite backups (periodic online backup + integrity check + retention pruning)
ENABLE_SQLITE_BACKUPS=false
SQLITE_BACKUP_DIR=
SQLITE_BACKUP_INTERVAL_MINUTES=60
SQLITE_BACKUP_RETENTION=24

# Off-site SQLite backup copy (S3-compatible object storage; disabled by
# default, attempted only after a successful local backup above -- see
# backend/services/sqlite-offsite-backup.js). OFFSITE_BACKUP_ENDPOINT is
# optional: leave blank to use AWS S3's own default endpoint for the given
# region, or set it for any other S3-compatible provider. Remote retention
# is a bucket lifecycle policy configured on the provider side, not here.
ENABLE_OFFSITE_BACKUP=false
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_ENDPOINT=
OFFSITE_BACKUP_REGION=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
OFFSITE_BACKUP_KEY_PREFIX=

# Printify
ENABLE_PRINTIFY_SYNC=false
PRINTIFY_API_TOKEN=your_printify_token
PRINTIFY_SHOP_ID=27495153
PRINTIFY_WEBHOOK_URL=https://custom-ecommerce-qp30.onrender.com/api/webhooks/printify

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_CHAT_ID=your_telegram_chat_id

# Stripe live
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPlus
PAYPLUS_API_KEY=your_payplus_api_key

# Resend (transactional email)
RESEND_API_KEY=
BRAND_LOGO_URL=

# IP geolocation (optional — leave blank to use ipapi.co free tier, 1000/day)
# Get a key at https://ipapi.co/ for higher volume
IPAPI_KEY=

# Admin (shared secret for /api/admin/* endpoints)
JONO_ADMIN_SECRET=

# Custom mockup pipeline
CLOUDINARY_URL=
MOCKUP_TEMPLATE_FRONT_BACKGROUND=
MOCKUP_TEMPLATE_FRONT_SHADOWS=
MOCKUP_TEMPLATE_FRONT_HIGHLIGHTS=
MOCKUP_TEMPLATE_BACK_BACKGROUND=
MOCKUP_TEMPLATE_BACK_SHADOWS=
MOCKUP_TEMPLATE_BACK_HIGHLIGHTS=
MOCKUP_FRONT_GEOMETRY_JSON={"top":350,"left":350,"width":900,"height":900,"fit":"contain"}
MOCKUP_BACK_GEOMETRY_JSON={"top":320,"left":350,"width":900,"height":900,"fit":"contain"}
